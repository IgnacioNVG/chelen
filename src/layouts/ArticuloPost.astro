---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseHead from "../components/layout/BaseHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ContentImage from "../components/ui/ContentImage.astro";
import FormattedDate from "../components/ui/FormattedDate.astro";
import AuthorLink from "../components/ui/AuthorLink.astro";
import ItemCard from "../components/ui/ItemCard.astro";
import { resolveAuthorRef } from "../lib/authorSlug";
import { temaSlug } from "../lib/taxonomy";
import type { ImageMetadata } from "astro";

type Props = Omit<
    CollectionEntry<"articulos">["data"],
    "heroImage" | "author"
> & {
    heroImage?: ImageMetadata | string;
    author?: string | { id: string };
};

const { title, description, heroImage, author, affiliation, category, temas } =
    Astro.props;
const authorId = resolveAuthorRef(author);
const currentArticleId = decodeURIComponent(
    Astro.url.pathname.split('/').filter(Boolean).pop() || ""
);

const allArticulos = await getCollection("articulos");
const otherArticulos = allArticulos.filter((post) => post.id !== currentArticleId);

const latestPosts = otherArticulos
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 4);

const latestIds = latestPosts.map(p => p.id);

const currentTemas = temas || [];
const similarPosts = otherArticulos
    .filter(post => !latestIds.includes(post.id))
    .filter(post => {
        const postTemas = post.data.temas || [];
        return currentTemas.some(tema => postTemas.includes(tema));
    })
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<html lang="es">
    <head>
        <BaseHead title={title} description={description} />
        <style>
            :global(body) {
                overflow-x: hidden;
            }

            main {
                width: min(1240px, calc(100% - 2rem));
                margin: 0 auto;
                padding: clamp(1.5rem, 4vw, 3rem) 0 4rem;
                display: grid;
                grid-template-columns: minmax(0, 1fr) 340px;
                gap: clamp(2rem, 5vw, 4rem);
                align-items: start;
            }

            article {
                min-width: 0;
            }

            .hero-image {
                width: 100%;
                aspect-ratio: 2 / 1;
                margin-bottom: 2rem;
                background: #f5f5f5;
                border: 2px solid #111;
                border-radius: 8px;
                box-shadow: 4px 4px 0px 0px #111;
                overflow: hidden;
                -webkit-mask-image: -webkit-radial-gradient(white, black);
                transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            }

            .hero-image:hover {
                transform: translate(-3px, -3px);
                box-shadow: 6px 6px 0px 0px #ff0000;
                border-color: #ff0000;
            }

            .hero-image :global(img),
            .hero-image img {
                width: 100%;
                height: 100%;
                display: block;
                object-fit: cover;
                object-position: center;
                border-radius: 0;
                transform: scale(1.01);
                transition: transform 0.3s ease;
            }

            .hero-image:hover :global(img),
            .hero-image:hover img {
                transform: scale(1.04);
            }

            .header-content {
                border-top: 0.45rem solid #111;
                border-bottom: 2px solid #111;
                padding: 0.75rem 0 2rem;
                margin-bottom: 3rem;
            }

            .article-category {
                display: inline-block;
                background: #111;
                color: #fff;
                padding: 0.18rem 0.5rem;
                font-family: monospace;
                font-size: 0.72rem;
                text-transform: uppercase;
                font-weight: bold;
            }

            .article-title {
                font-family: "Sifonn", sans-serif;
                font-size: clamp(2.2rem, 5vw, 4.2rem);
                text-transform: uppercase;
                line-height: 0.9;
                margin: 1rem 0;
                max-width: 12ch;
                color: #111;
            }

            .article-meta {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                border-top: 1px solid #111;
                border-bottom: 1px solid #111;
                padding: 0.85rem 0;
                font-family: monospace;
                text-transform: uppercase;
                gap: 1rem;
                font-size: 0.78rem;
            }

            .article-author {
                font-weight: bold;
                color: #ff0000;
            }

            .article-affiliation {
                color: #666;
                text-align: right;
            }

            .article-description {
                font-size: clamp(1.1rem, 2.5vw, 1.35rem);
                font-style: italic;
                margin: 1.5rem 0 0;
                line-height: 1.35;
                color: #333;
                max-width: 42rem;
            }

            .article-temas {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
                margin-top: 1.5rem;
            }

            .article-tema {
                font-family: monospace;
                font-size: 0.7rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: #111;
                text-decoration: none;
                background: #eee;
                border: 1px solid #111;
                padding: 0.25rem 0.6rem;
                transition:
                    background 0.2s,
                    color 0.2s;
            }

            .article-tema:hover {
                background: #ff0000;
                color: #fff;
                border-color: #ff0000;
            }

            .prose {
                font-size: 1.12rem;
                line-height: 1.7;
                color: #222;
            }

            .prose :global(p) {
                margin-bottom: 1.6em;
            }

            .prose :global(a) {
                color: #111;
                text-decoration: none;
                border-bottom: 2px solid #111;
            }

            .prose :global(a:hover) {
                color: #ff0000;
                border-color: #ff0000;
            }

            .prose :global(blockquote) {
                border-left: 4px solid #ff1321;
                background: #fff;
                padding: 1rem 1.25rem;
                font-size: 1.2rem;
            }

            .sidebar {
                position: sticky;
                top: 2rem;
                max-height: calc(100vh - 3rem);
                display: flex;
                flex-direction: column;
                min-height: 0;
            }

            .sidebar-title {
                font-family: "Sifonn", sans-serif;
                font-size: 1.3rem;
                text-transform: uppercase;
                line-height: 1;
                border-top: 0.45rem solid #111;
                margin: 0 0 1.25rem;
                padding-top: 0.5rem;
                color: #111;
            }

            .sidebar-section {
                margin-bottom: 2.5rem;
            }

            .sidebar-list {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
                overflow-y: auto;
                overscroll-behavior: contain;
                padding: 0 0.5rem 0.5rem 0;
                scrollbar-width: thin;
                scrollbar-color: #111 transparent;
            }

            .sidebar-list::-webkit-scrollbar {
                width: 8px;
            }

            .sidebar-list::-webkit-scrollbar-track {
                background: transparent;
            }

            .sidebar-list::-webkit-scrollbar-thumb {
                background: #111;
                border-radius: 999px;
            }



            @media (max-width: 960px) {
                main {
                    grid-template-columns: 1fr;
                }

                .sidebar {
                    position: static;
                    margin-top: 2rem;
                    max-height: none;
                }

                .sidebar-list {
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);
                    overflow: visible;
                    padding-right: 0;
                }
            }

            @media (max-width: 640px) {
                .article-title {
                    max-width: none;
                }

                .article-meta {
                    flex-direction: column;
                }

                .article-affiliation {
                    text-align: left;
                }

                .sidebar-list {
                    grid-template-columns: 1fr;
                }
            }
        </style>
    </head>

    <body>
        <Header />
        <main>
            <article>
                {
                    heroImage && (
                        <div class="hero-image">
                            {typeof heroImage === "string" ? (
                                <img
                                    src={heroImage}
                                    alt=""
                                    loading="eager"
                                    decoding="sync"
                                />
                            ) : (
                                <ContentImage
                                    src={heroImage}
                                    alt=""
                                    width={960}
                                    priority
                                />
                            )}
                        </div>
                    )
                }

                <header class="header-content">
                    {
                        category && (
                            <span class="article-category">{category}</span>
                        )
                    }
                    <h1 class="article-title">{title}</h1>
                    <div class="article-meta">
                        <span class="article-author"
                            >Por <AuthorLink
                                name={authorId || "Redacción Chelén"}
                            /></span
                        >
                        <span class="article-affiliation">{affiliation}</span>
                    </div>
                    <p class="article-description">{description}</p>
                    {
                        temas && temas.length > 0 && (
                            <nav class="article-temas" aria-label="Temas">
                                {temas.map((tema) => (
                                    <a
                                        class="article-tema"
                                        href={`/tema/${temaSlug(tema)}`}
                                    >
                                        {tema}
                                    </a>
                                ))}
                            </nav>
                        )
                    }
                </header>

                <div class="prose">
                    <slot />
                </div>
            </article>

            <aside class="sidebar">
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Últimas Publicaciones</h3>
                    <div class="sidebar-list">
                        {
                            latestPosts.map((post) => {
                                return (
                                    <div class="sidebar-card-wrapper">
                                        <ItemCard
                                            title={post.data.title}
                                            href={`/escritos/articulos/${post.id}/`}
                                            heroImage={post.data.heroImage}
                                            category={post.data.category || 'Artículo'}
                                            author={resolveAuthorRef(post.data.author) || "Redacción"}
                                            date={post.data.pubDate}
                                            format="landscape"
                                        />
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>

                {similarPosts.length > 0 && (
                    <div class="sidebar-section">
                        <h3 class="sidebar-title">Temas Relacionados</h3>
                        <div class="sidebar-list">
                            {
                                similarPosts.map((post) => {
                                    return (
                                        <div class="sidebar-card-wrapper">
                                            <ItemCard
                                                title={post.data.title}
                                                href={`/escritos/articulos/${post.id}/`}
                                                heroImage={post.data.heroImage}
                                                category={post.data.category || 'Artículo'}
                                                author={resolveAuthorRef(post.data.author) || "Redacción"}
                                                date={post.data.pubDate}
                                                format="landscape"
                                            />
                                        </div>
                                    );
                                })
                            }
                        </div>
                    </div>
                )}
            </aside>
        </main>
        <Footer />
    </body>
</html>
