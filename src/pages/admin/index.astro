---
import AdminLayout from "../../components/admin/AdminLayout.astro";

// In a real app we'd fetch counts from DB
const env = (Astro.locals as any).runtime?.env;
let db = env?.DB;

let stats = {
  articulos: 0,
  cartas: 0,
  poemas: 0,
  columnistas: 0
};

if (db) {
  try {
    stats.articulos = await db.prepare('SELECT count(*) as c FROM articulos').first('c');
    stats.cartas = await db.prepare('SELECT count(*) as c FROM cartas').first('c');
    stats.poemas = await db.prepare('SELECT count(*) as c FROM poemas').first('c');
    stats.columnistas = await db.prepare('SELECT count(*) as c FROM columnistas').first('c');
  } catch(e) {
    console.error("DB Error: ", e);
  }
}
---
<AdminLayout title="Dashboard">
  <header class="admin-header">
    <h1>Bienvenido al Panel de Control</h1>
  </header>

  <section class="stats-grid">
    <div class="stat-card">
      <h3>Artículos</h3>
      <p class="number">{stats.articulos}</p>
      <a href="/admin/articulos">Administrar &rarr;</a>
    </div>
    
    <div class="stat-card">
      <h3>Cartas</h3>
      <p class="number">{stats.cartas}</p>
      <a href="/admin/cartas">Administrar &rarr;</a>
    </div>
    
    <div class="stat-card">
      <h3>Poemas</h3>
      <p class="number">{stats.poemas}</p>
      <a href="/admin/poemas">Administrar &rarr;</a>
    </div>
    
    <div class="stat-card">
      <h3>Autores</h3>
      <p class="number">{stats.columnistas}</p>
      <a href="/admin/columnistas">Administrar &rarr;</a>
    </div>
  </section>
</AdminLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  
  .stat-card {
    background: white;
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border: 1px solid #eaeaea;
  }
  .stat-card h3 {
    font-size: 1rem;
    color: #666;
    margin-bottom: 0.5rem;
  }
  .stat-card .number {
    font-size: 2.5rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1rem;
  }
  .stat-card a {
    color: #0066cc;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .stat-card a:hover {
    text-decoration: underline;
  }
</style>


