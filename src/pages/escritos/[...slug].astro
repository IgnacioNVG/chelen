---
import ArticuloPost from '../../layouts/ArticuloPost.astro';
import { marked } from 'marked';

const { slug } = Astro.params;

const db = (Astro.locals as any).runtime?.env?.DB;
if (!db) {
  return new Response("Database not found", { status: 500 });
}

const post = await db.prepare('SELECT * FROM articulos WHERE slug = ?').bind(slug).first();

if (!post) {
  return Astro.redirect('/404');
}

// Convert JSON strings back to arrays for the layout component
const parsedPost = {
  ...post,
  pubDate: new Date(post.pubDate),
  temas: post.temas ? JSON.parse(post.temas) : [],
  tags: post.tags ? JSON.parse(post.tags) : []
};

const contentHtml = post.content ? marked.parse(post.content) : '';
---

<ArticuloPost {...parsedPost}>
	<div set:html={contentHtml}></div>
</ArticuloPost>