---
import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FeedCard from '../components/home/FeedCard.astro';
import ItemCard from '../components/ui/ItemCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import {
    buildAntologiaItems,
    buildArticuloItems,
    buildCartaItems,
    buildPoemaItems,
    mergeEditorialFeed,
    editionLabel,
} from '../lib/homeFeed';

const articulos = await getCollection('articulos');
const cartas = await getCollection('cartas');
const antologias = await getCollection('antologias');
const poemas = await getCollection('poemas');

const editorialFeed = mergeEditorialFeed(
    buildArticuloItems(articulos),
    buildCartaItems(cartas),
    buildPoemaItems(poemas),
    buildAntologiaItems(antologias, poemas),
);

const edicion = editionLabel(editorialFeed);

const heroMain = editorialFeed[0];
const heroSide1 = editorialFeed[1];
const heroSide2 = editorialFeed[2];

const feedSinHero = editorialFeed.slice(3);
const publicacionesRecientes = feedSinHero.slice(0, 6);
const recientesIds = new Set([
    ...publicacionesRecientes.map((d) => d.id),
    heroMain?.id,
    heroSide1?.id,
    heroSide2?.id,
].filter(Boolean));

const columnasRecientes = feedSinHero
    .filter((item) => item.kind === 'articulo' && !recientesIds.has(item.id))
    .slice(0, 3);
    
const arteReciente = feedSinHero
    .filter((item) => item.kind === 'poema' || item.kind === 'antologia')
    .slice(0, 3);

const cartasRecientesItems = feedSinHero.filter((item) => item.kind === 'carta').slice(0, 3);
const cartasRecientesConContenido = await Promise.all(
    cartasRecientesItems.map(async (item) => {
        const slug = item.id.replace('carta-', '');
        const entry = await getEntry('cartas', slug);
        if (entry) {
            const { Content } = await render(entry);
            return { ...item, Content };
        }
        return { ...item, Content: null };
    })
);

const graphicFiles = import.meta.glob<{ default: ImageMetadata }>(
    '../assets/grafica-*.{webp,png,jpg,jpeg}',
);
const graphics = (
    await Promise.all(
        Object.keys(graphicFiles).map(async (path) => {
            const img = await graphicFiles[path]();
            const fileName = path.split('/').pop()?.replace(/\.[^.]+$/, '') ?? '';
            const order = Number.parseInt(fileName.replace('grafica-', ''), 10) || 0;
            const title = fileName.replace('grafica-', 'Pieza ').replace(/-/g, ' ');
            return { id: fileName, title, src: img.default, order };
        }),
    )
).sort((a, b) => a.order - b.order);

const graficaDestacada = graphics.slice(-3).reverse();
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            .home {
                width: min(1380px, calc(100% - 2rem));
                margin: 0 auto;
                padding: 1.5rem 0 4rem;
            }

            .masthead {
                border-bottom: 4px solid #111;
                padding-bottom: 1.25rem;
                margin-bottom: 2rem;
            }

            .masthead-kicker {
                display: inline-block;
                font-family: monospace;
                font-size: 0.85rem;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                color: #fff;
                background-color: #ff1321;
                border: 2px solid #111;
                box-shadow: 4px 4px 0px #111;
                padding: 0.35rem 0.85rem;
                margin: 0 0 1.2rem;
                transform: rotate(-2deg);
                transition: transform 0.2s ease;
            }

            .masthead-kicker:hover {
                transform: rotate(0deg) translate(-2px, -2px);
                box-shadow: 6px 6px 0px #111;
            }

            .masthead-title {
                font-family: 'Sifonn', sans-serif;
                font-size: clamp(2.2rem, 6vw, 4rem);
                text-transform: uppercase;
                line-height: 0.95;
                margin: 0 0 0.35rem;
                color: #111;
            }

            .masthead-edition {
                font-family: monospace;
                font-size: 0.8rem;
                color: #444;
                margin: 0;
                font-weight: bold;
            }

            .section-band {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                border-top: 5px solid #111;
                padding-top: 1rem;
                margin: 3.5rem 0 1.5rem;
            }
            
            .section-band--compact {
                margin: 0 0 1.5rem 0;
                padding-top: 0;
                border-top: none;
                border-bottom: 3px solid #111;
                padding-bottom: 0.5rem;
            }

            .section-band h2 {
                font-family: 'Sifonn', sans-serif;
                font-size: clamp(1.2rem, 2.5vw, 1.75rem);
                text-transform: uppercase;
                margin: 0;
                color: #111;
            }

            .section-band a {
                font-family: monospace;
                font-size: 0.75rem;
                font-weight: 700;
                text-transform: uppercase;
                color: #fff;
                background-color: #111;
                padding: 0.35rem 0.75rem;
                text-decoration: none;
                border: 2px solid #111;
                box-shadow: 3px 3px 0px #ff1321;
                transition: all 0.1s ease-in-out;
            }

            .section-band a:hover {
                transform: translate(2px, 2px);
                box-shadow: 1px 1px 0px #ff1321;
                background-color: #ff1321;
                border-color: #ff1321;
            }

            /* --- NEWSPAPER HERO --- */
            .hero-newspaper {
                display: grid;
                grid-template-columns: 1fr;
                gap: 2rem;
                margin-bottom: 4rem;
            }
            
            @media (min-width: 900px) {
                .hero-newspaper {
                    grid-template-columns: 2fr 1fr;
                }
            }

            .hero-main {
                display: flex;
                flex-direction: column;
            }
            
            .hero-main :global(.item-card) {
                height: 100%;
            }

            .hero-main :global(.item-body) {
                margin-top: auto;
            }

            .hero-sidebar {
                display: flex;
                flex-direction: column;
                gap: 2rem;
            }

            /* --- MAIN LAYOUT (SIDEBAR FOR CARTAS) --- */
            .newspaper-layout {
                display: grid;
                grid-template-columns: 1fr;
                gap: 3rem;
            }

            @media (min-width: 1024px) {
                .newspaper-layout {
                    grid-template-columns: 3fr 1fr;
                    align-items: start;
                }
            }

            .newspaper-main {
                display: flex;
                flex-direction: column;
            }

            .newspaper-sidebar {
                position: sticky;
                top: 2rem;
                display: flex;
                flex-direction: column;
                gap: 2rem;
            }

            /* Cartas Scrollable Box */
            .cartas-scrollable {
                display: flex;
                flex-direction: column;
                gap: 2rem;
                max-height: 85vh; /* Prevents it from going forever */
                overflow-y: auto;
                padding-right: 1rem;
            }

            /* Custom Scrollbar for Cartas */
            .cartas-scrollable::-webkit-scrollbar {
                width: 6px;
            }
            .cartas-scrollable::-webkit-scrollbar-track {
                background: #f1f1f1;
                border-left: 1px solid #ddd;
            }
            .cartas-scrollable::-webkit-scrollbar-thumb {
                background: #111;
            }

            .carta-texto-completo {
                font-family: Georgia, 'Times New Roman', Times, serif;
                font-size: 0.95rem;
                line-height: 1.6;
                color: #222;
                margin-top: 1rem;
                margin-bottom: 1.5rem;
                border-left: 3px solid #ddd;
                padding-left: 1rem;
            }
            
            .carta-texto-completo p {
                margin-top: 0;
                margin-bottom: 1rem;
            }

            /* --- MASONRY GRID (Aumentado de columnas) --- */
            .brutalist-masonry {
                column-count: 1;
                column-gap: 2rem;
                list-style: none;
                padding: 0;
                margin: 0 0 2rem 0;
                width: 100%;
            }

            @media (min-width: 640px) {
                .brutalist-masonry {
                    column-count: 2;
                }
            }

            @media (min-width: 1200px) {
                .brutalist-masonry {
                    column-count: 3;
                }
            }

            /* Contenedor del item que evita romperse entre columnas */
            .masonry-item {
                break-inside: avoid;
                margin-bottom: 2rem;
                display: flex;
                flex-direction: column;
            }

            .masonry-item > * {
                width: 100%;
                margin: 0 !important;
            }

            .editorial-note {
                border: 3px solid #111;
                background: #ffea00;
                box-shadow: 5px 5px 0px #111;
                padding: clamp(1.2rem, 2vw, 1.8rem);
                max-width: 760px;
                margin-bottom: 2rem;
            }

            .editorial-note p {
                margin: 0;
                font-size: 1rem;
                font-weight: bold;
                line-height: 1.55;
                color: #111;
            }

            .editorial-note--compact {
                max-width: 620px;
                background: #fff;
            }
        </style>
    </head>
    <body>
        <Header />
        <main class="home">
            <header class="masthead">
                <span class="masthead-kicker">"Organizar la Esperanza"</span>
                <h1 class="masthead-title">{SITE_TITLE}</h1>
                <p class="masthead-edition">
                    {SITE_DESCRIPTION}
                    {edicion && ` · ${edicion}`}
                </p>
            </header>

            <!-- 1. HERO NEWSPAPER -->
            <section class="hero-newspaper">
                {heroMain && (
                    <div class="hero-main masonry-item">
                        <ItemCard 
                            title={heroMain.title}
                            href={heroMain.href}
                            heroImage={heroMain.image}
                            category={heroMain.category}
                            description={heroMain.description}
                            author={heroMain.author}
                            date={heroMain.pubDate}
                            tags={heroMain.tags}
                            format="landscape"
                            isFeatured={true}
                        />
                    </div>
                )}
                <div class="hero-sidebar">
                    {heroSide1 && (
                        <div class="masonry-item">
                            <ItemCard 
                                title={heroSide1.title}
                                href={heroSide1.href}
                                heroImage={heroSide1.image}
                                category={heroSide1.category}
                                author={heroSide1.author}
                                date={heroSide1.pubDate}
                                tags={heroSide1.tags}
                                format="landscape"
                            />
                        </div>
                    )}
                    {heroSide2 && (
                        <div class="masonry-item">
                            <ItemCard 
                                title={heroSide2.title}
                                href={heroSide2.href}
                                heroImage={heroSide2.image}
                                category={heroSide2.category}
                                author={heroSide2.author}
                                date={heroSide2.pubDate}
                                tags={heroSide2.tags}
                                format="landscape"
                            />
                        </div>
                    )}
                </div>
            </section>

            <!-- 2. MAIN LAYOUT WITH SIDEBAR -->
            <div class="newspaper-layout">
                
                <div class="newspaper-main">
                    {publicacionesRecientes.length > 0 && (
                        <>
                            <div class="section-band">
                                <h2>Publicaciones recientes</h2>
                                <a href="/escritos">Ver publicaciones -></a>
                            </div>
                            <ul class="brutalist-masonry">
                                {publicacionesRecientes.map((item) => (
                                    <li class="masonry-item">
                                        <ItemCard 
                                            title={item.title}
                                            href={item.href}
                                            heroImage={item.image}
                                            category={item.category}
                                            author={item.author}
                                            date={item.pubDate}
                                            tags={item.tags}
                                            format="landscape"
                                        />
                                    </li>
                                ))}
                            </ul>
                        </>
                    )}

                    {columnasRecientes.length > 0 && (
                        <>
                            <div class="section-band">
                                <h2>Columnas recientes</h2>
                                <a href="/escritos/columnas">Ver columnas -></a>
                            </div>
                            <ul class="brutalist-masonry">
                                {columnasRecientes.map((item) => (
                                    <li class="masonry-item">
                                        <ItemCard 
                                            title={item.title}
                                            href={item.href}
                                            heroImage={item.image}
                                            category={item.category}
                                            author={item.author}
                                            date={item.pubDate}
                                            tags={item.tags}
                                            format="landscape"
                                        />
                                    </li>
                                ))}
                            </ul>
                        </>
                    )}

                    {arteReciente.length > 0 && (
                        <>
                            <div class="section-band">
                                <h2>Arte socialista destacado</h2>
                                <a href="/multimedia/arte">Ver arte -></a>
                            </div>
                            <ul class="brutalist-masonry">
                                {arteReciente.map((item) => (
                                    <li class="masonry-item">
                                        <ItemCard 
                                            title={item.title}
                                            href={item.href}
                                            heroImage={item.image}
                                            category={item.category}
                                            author={item.author}
                                            date={item.pubDate}
                                            tags={item.tags}
                                            format="portrait"
                                        />
                                    </li>
                                ))}
                            </ul>
                        </>
                    )}

                    {graficaDestacada.length > 0 && (
                        <>
                            <div class="section-band">
                                <h2>Grafica destacada</h2>
                                <a href="/multimedia/grafica">Ver todo -></a>
                            </div>
                            <ul class="brutalist-masonry">
                                {graficaDestacada.map((item) => (
                                    <li class="masonry-item">
                                        <ItemCard 
                                            title={item.title}
                                            href={`/multimedia/grafica`}
                                            heroImage={item.src}
                                            category="Archivo visual"
                                            tags={["Formato 4:5"]}
                                            format="portrait"
                                        />
                                    </li>
                                ))}
                            </ul>
                        </>
                    )}

                    <div class="section-band">
                        <h2>Produccion audiovisual reciente</h2>
                        <a href="/multimedia/audiovisual">Ver audiovisual -></a>
                    </div>
                    <section class="editorial-note">
                        <p>Podcast, conversatorios y paneles se agrupan en una seccion propia, preparada para incorporar nuevas categorias audiovisuales.</p>
                    </section>
                    
                    <div class="section-band">
                        <h2>Cuadernillos</h2>
                        <a href="/publicaciones/cuadernillos">Ver cuadernillos -></a>
                    </div>
                    <section class="editorial-note editorial-note--compact">
                        <p>Publicaciones especiales con portada, autores, fecha, descarga PDF y lectura online.</p>
                    </section>
                </div>

                <!-- SIDEBAR DERECHA: CARTAS AL DIRECTOR -->
                <aside class="newspaper-sidebar">
                    {cartasRecientesConContenido.length > 0 && (
                        <>
                            <div class="section-band section-band--compact">
                                <h2>Cartas al director</h2>
                                <a href="/escritos/cartas">Ver -></a>
                            </div>
                            <div class="cartas-scrollable">
                                {cartasRecientesConContenido.map((item) => (
                                    <div class="masonry-item">
                                        <ItemCard 
                                            title={item.title}
                                            href={item.href}
                                            heroImage={undefined}
                                            category={item.category}
                                            author={item.author}
                                            date={item.pubDate}
                                            tags={item.tags}
                                        >
                                            {item.Content ? (
                                                <div class="carta-texto-completo">
                                                    <item.Content />
                                                </div>
                                            ) : (
                                                <p class="carta-texto-completo">{item.description}</p>
                                            )}
                                        </ItemCard>
                                    </div>
                                ))}
                            </div>
                        </>
                    )}
                </aside>

            </div>
        </main>
        <Footer />
    </body>
</html>
