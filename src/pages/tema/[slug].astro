---
const db = (Astro.locals as any).runtime?.env?.DB;
import BaseHead from '../../components/layout/BaseHead.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ItemCard from '../../components/ui/ItemCard.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from '../../lib/d1Content';
import { TEMAS, temaSlug } from '../../lib/taxonomy';
import {
	buildAntologiaItems,
	buildArticuloItems,
	buildCartaItems,
	buildPoemaItems,
	mergeEditorialFeed,
} from '../../lib/homeFeed';

const { slug } = Astro.params;

// Find the original tema string from the slug
const tema = TEMAS.find(t => temaSlug(t) === slug);
if (!tema) {
	return Astro.redirect('/404');
}

const [articulos, cartas, antologias, poemas] = await Promise.all([
	getCollection(db, 'articulos'),
	getCollection(db, 'cartas'),
	getCollection(db, 'antologias'),
	getCollection(db, 'poemas'),
]);

const feed = mergeEditorialFeed(
	buildArticuloItems(articulos),
	buildCartaItems(cartas),
	buildPoemaItems(poemas),
	buildAntologiaItems(antologias, poemas),
);

const items = feed.filter((item) => item.temas.includes(tema));
const titulo = `Tema · ${tema}`;
const descripcion = `Todo el contenido de Revista Chelén sobre ${tema}: columnas, cartas, poesía y más.`;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${tema} — ${SITE_TITLE}`} description={descripcion} />
		<style>
			main {
				width: calc(100% - 4vw);
				max-width: 1800px;
				margin: 0 auto;
				padding: 2rem 0 4rem;
			}

			.tema-header {
				border-bottom: 4px solid #111;
				padding-bottom: 1.25rem;
				margin-bottom: 2.5rem;
			}

			.tema-kicker {
				font-family: monospace;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.2em;
				color: #666;
				margin: 0 0 0.5rem;
			}

			.tema-title {
				font-family: 'Satoshi', sans-serif;
				font-size: clamp(2.2rem, 6vw, 4rem);
				text-transform: uppercase;
				line-height: 0.95;
				margin: 0 0 0.35rem;
				color: #111;
			}

			.tema-count {
				font-family: monospace;
				font-size: 0.8rem;
				color: #444;
				margin: 0;
			}

			.tema-back {
				display: inline-block;
				margin-top: 1rem;
				font-family: monospace;
				font-size: 0.7rem;
				text-transform: uppercase;
				color: #111;
				text-decoration: none;
				border-bottom: 1px solid #111;
			}

			.tema-back:hover { color: #ff1321; border-color: #ff1321; }

			.empty {
				border: 2px solid #111;
				background: #fff;
				padding: clamp(1rem, 2vw, 1.5rem);
				font-size: 0.95rem;
				color: #333;
			}

			/* --- Grilla Masonry --- */
			.brutalist-masonry {
				column-count: 1;
				column-gap: 2rem;
				list-style: none;
				padding: 0;
				margin: 0 0 2rem 0;
				width: 100%;
			}

			@media (min-width: 640px) {
				.brutalist-masonry { column-count: 2; }
			}

			@media (min-width: 1024px) {
				.brutalist-masonry { column-count: 3; }
			}

			@media (min-width: 1440px) {
				.brutalist-masonry { column-count: 4; }
			}

			.masonry-item {
				break-inside: avoid;
				margin-bottom: 2rem;
				display: flex;
				flex-direction: column;
			}

			.masonry-item > * {
				width: 100%;
				margin: 0 !important;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="tema-header">
				<p class="tema-kicker">Tema</p>
				<h1 class="tema-title">{tema}</h1>
				<p class="tema-count">
					{items.length} publicaci{items.length === 1 ? 'ón' : 'ones'} en todas las secciones
				</p>
				<a class="tema-back" href="/temas">&larr; Todos los temas</a>
			</header>

			{items.length > 0 ? (
				<ul class="brutalist-masonry">
					{items.map((item) => (
						<li class="masonry-item">
							<ItemCard 
								title={item.title}
								href={item.href}
								heroImage={item.image}
								category={item.category}
								author={item.author}
								date={item.pubDate}
								temas={item.temas}
								tags={item.tags}
								format={['carta', 'poema'].includes(item.kind) ? 'portrait' : 'landscape'}
							/>
						</li>
					))}
				</ul>
			) : (
				<p class="empty">Aún no hay publicaciones bajo este tema.</p>
			)}
		</main>
		<Footer />
	</body>
</html>
