{
  "name": "chelen",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "d25bfdb9b83a4935807c058d1dd72820"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chelen-db",
      "database_id": "45ffb33f-a7e4-450a-a83a-5c2dcc25e722",
      "migrations_dir": "migrations"
    }
  ]
}
